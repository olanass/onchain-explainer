{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "buildCommand": "",
  "outputDirectory": "public",
  "functions": { "api/explain.js": { "maxDuration": 30 } },
  "rewrites": [
    { "source": "/v1/transactions/explain", "destination": "/api/explain" },
    { "source": "/health", "destination": "/api/health" },
    { "source": "/publish", "destination": "/publish.html" }
  ],
  "headers": [{ "source": "/(.*)", "headers": [
    { "key": "X-Content-Type-Options", "value": "nosniff" },
    { "key": "Referrer-Policy", "value": "no-referrer" },
    { "key": "X-Frame-Options", "value": "DENY" },
    { "key": "Content-Security-Policy", "value": "default-src 'self'; script-src 'self'; style-src 'self'; connect-src 'self' https://olanas.xyz; frame-ancestors 'none'; base-uri 'none'; form-action 'self'" }
  ] }]
}
